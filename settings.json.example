{
    "app1": {
        "watch_dirs": [
            "C:/Media/Movies",
            "C:/Media/TV"
        ],
        "temp_audio_dir": "./temp_audio",
        "ffmpeg_path": "ffmpeg",
        "audio_format": "wav",
        "audio_sample_rate": 16000,
        "whisper_model": "small",
        "whisper_language": null,
        "whisper_device": "cpu",
        "whisper_compute_type": "int8",
        "watchdog_poll_interval": 5,
        "processed_log": "./processed_files.log",
        "cleanup_audio": true,
        "log_level": "INFO"
    },
    "app2": {
        "llm_provider": "google",
        "llm_api_key": "YOUR_GEMINI_OR_OPENAI_API_KEY_HERE",
        "llm_model": "gemini-1.5-flash",
        "llm_base_url": null,
        "translation_batch_size": 30,
        "target_language": "Hungarian",
        "translation_style_hint": "Use natural, colloquial language as used in Hungarian movie dubbing.",
        "api_request_delay": 0.5,
        "log_level": "INFO"
    }
}
