{
    "app1": {
        "watch_dirs": [
            "C:/Media/Movies",
            "C:/Media/TV"
        ],
        "temp_audio_dir": "./temp_audio",
        "ffmpeg_path": "ffmpeg",
        "audio_format": "wav",
        "audio_sample_rate": 16000,
        "whisper_model": "small",
        "whisper_language": null,
        "whisper_device": "cpu",
        "whisper_compute_type": "int8",
        "watchdog_poll_interval": 5,
        "processed_log": "./processed_files.log",
        "cleanup_audio": true,
        "log_level": "INFO",
        "extract_embedded_subs": true,
        "embedded_sub_languages": [
            "eng",
            "en"
        ],
        "minimize_to_tray": true,
        "download_online_subtitles": true,
        "opensubtitles_api_key": "",
        "auto_sync_subtitles": false,
        "quality_gate_enabled": true,
        "web_dashboard_enabled": false,
        "web_dashboard_port": 8080,
        "web_dashboard_host": "0.0.0.0"
    },
    "app2": {
        "llm_provider": "google",
        "llm_api_key": "YOUR_GEMINI_OR_OPENAI_API_KEY_HERE",
        "llm_model": "gemini-1.5-flash",
        "llm_base_url": null,
        "translation_batch_size": 30,
        "target_language": "Hungarian",
        "translation_style_hint": "Use natural, colloquial language as used in Hungarian movie dubbing.",
        "api_request_delay": 0.5,
        "log_level": "INFO",
        "use_sliding_context": true,
        "sliding_context_size": 4,
        "series_memory_enabled": true,
        "parallel_translation_workers": 2,
        "plex_auto_refresh": false,
        "plex_url": "http://localhost:32400",
        "plex_token": "",
        "notifications_enabled": false,
        "discord_webhook_url": "",
        "telegram_bot_token": "",
        "telegram_chat_id": ""
    }
}
