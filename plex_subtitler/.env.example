# =============================================================================
# Plex Subtitler - Környezeti változók konfigurációja
# =============================================================================
# Másold át ezt a fájlt ".env" névvel (a .env.example másolatát),
# és töltsd ki a saját értékeiddel!
# SOHA ne commitold a .env fájlt verziókezelőbe!
# =============================================================================


# =============================================================================
# APP 1: Audio Extractor & Whisper STT
# =============================================================================

# --- Figyelt mappák ---
# A figyelni kívánt mappa(k) teljes elérési útja.
# Több mappa esetén vesszővel válaszd el őket.
# Windows: használj duplaszlasht (\\) vagy normál "/" előre törtvonalat.
WATCH_DIRS=C:/Media/Movies,C:/Media/TV

# Ideiglenes audiofájlok tárolási helye (automatikusan létrejön)
TEMP_AUDIO_DIR=./temp_audio

# --- FFmpeg ---
# Ha az ffmpeg nincs a PATH-ban, add meg a teljes elérési útját:
# FFMPEG_PATH=C:/ffmpeg/bin/ffmpeg.exe
FFMPEG_PATH=ffmpeg

# Audiofájl formátuma: "wav" (ajánlott Whisper-hez) vagy "mp3"
AUDIO_FORMAT=wav

# Mintavételezési frekvencia Hz-ben (16000 = Whisper-optimális, ne változtasd)
AUDIO_SAMPLE_RATE=16000

# --- Whisper modell ---
# Méretek (sebesség vs. pontosság): tiny | base | small | medium | large-v2 | large-v3
# Ajánlás: CPU-n "medium", GPU-n "large-v2" vagy "large-v3"
WHISPER_MODEL=medium

# Automatikus nyelvfelismerés (hagyd üresen), vagy add meg pl.: en, hu, de
WHISPER_LANGUAGE=

# Futtatási eszköz: "cpu" vagy "cuda" (NVIDIA GPU-hoz)
WHISPER_DEVICE=cpu

# Számítási típus: "int8" (CPU, ajánlott), "float16" (NVIDIA GPU)
WHISPER_COMPUTE_TYPE=int8

# --- Egyéb beállítások ---
# Watchdog pollozási intervallum másodpercben (ha az OS-esemény nem megbízható)
WATCHDOG_POLL_INTERVAL=5

# Feldolgozott fájlok naplójának elérési útja
PROCESSED_LOG=./processed_files.log

# Ideiglenes audiofájl törlése a transzkripció után? (true/false)
CLEANUP_AUDIO=true


# =============================================================================
# APP 2: AI Translator Agent
# =============================================================================

# --- LLM API ---
# Provider: openai | anthropic | google | ollama
LLM_PROVIDER=openai

# API kulcs (OpenAI, Anthropic, stb.)
LLM_API_KEY=sk-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Modell neve (a provider szerint)
# OpenAI:    gpt-4o, gpt-4o-mini, gpt-4-turbo
# Anthropic: claude-3-5-sonnet-20241022
# Google:    gemini-1.5-pro
# Ollama:    llama3, mistral, stb.
LLM_MODEL=gpt-4o-mini

# Csak Ollama-hoz: az API alap URL-je (pl. http://localhost:11434)
# LLM_BASE_URL=http://localhost:11434

# --- Fordítási beállítások ---
# Egy API-hívásban egyszerre feldolgozott feliratblokkok száma
TRANSLATION_BATCH_SIZE=30

# Célnyelv megnevezése angolul (megjelenik a promptban)
TARGET_LANGUAGE=Hungarian

# Stílusutasítás a fordítónak
TRANSLATION_STYLE_HINT=Use natural, colloquial language as used in Hungarian movie dubbing.

# API hívások közötti várakozás (rate limiting), másodpercben
API_REQUEST_DELAY=0.5


# =============================================================================
# KÖZÖS BEÁLLÍTÁSOK
# =============================================================================

# Naplózási szint: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
